{
	"name": "@starter/email",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"dev": "email dev --port 3002 --dir ./src/emails",
		"react-doctor": "react-doctor . --score --blocking error",
		"typecheck": "tsc --noEmit --skipLibCheck"
	},
	"dependencies": {
		"@starter/utils": "workspace:*",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-email": "^6.11.1"
	},
	"devDependencies": {
		"@react-email/ui": "6.11.1",
		"@starter/tsconfig": "workspace:*",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"autoprefixer": "^10.6.1",
		"postcss": "^8.5.29",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2"
	},
	"reactDoctor": {
		"ignore": {
			"overrides": [
				{
					"files": [
						"src/emails/*.tsx"
					],
					"rules": [
						"import/no-default-export"
					]
				},
				{
					"files": [
						"src/components/logo.tsx"
					],
					"rules": [
						"deslop/unused-file"
					]
				}
			]
		}
	}
}
