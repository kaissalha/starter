						"actions": [],
						"items": [
							{
								"question": "What is your design process?",
								"answer": "Our process begins with understanding your needs, site conditions, and budget. We then develop schematic designs, refine them through design development, and create detailed construction documents. Throughout, we maintain close collaboration with you and your team."
							},
							{
								"question": "How long does a typical project take?",
								"answer": "Timeline varies by project scope. A residential design typically takes 3-6 months from initial consultation to construction documents. Commercial projects may take 6-12 months or more depending on complexity and regulatory requirements."
							},
							{
								"question": "Do you handle permits and approvals?",
								"answer": "Yes, we assist with permit processing and can coordinate with local authorities. We prepare all necessary documentation and can represent your project through the approval process."
							},
							{
								"question": "What areas do you serve?",
								"answer": "We primarily serve the greater metropolitan area but take on select projects nationally. Contact us to discuss your project location and we'll determine if we're a good fit."
							},
							{
								"question": "Can you work within my budget?",
								"answer": "We work with a range of budgets and will be transparent about what's achievable. During our initial consultation, we'll discuss your budget and develop a scope that aligns with your financial parameters."
							}
						]
					},
