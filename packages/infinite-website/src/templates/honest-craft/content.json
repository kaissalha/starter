						"items": [
							{
								"question": "Do you provide free estimates?",
								"answer": "Yes! We offer free, no-obligation estimates for all projects. We'll visit your site, discuss your needs, and provide a detailed quote."
							},
							{
								"question": "Are you licensed and insured?",
								"answer": "Absolutely. We are fully licensed, bonded, and insured. We carry both liability and workers' compensation insurance for your protection."
							},
							{
								"question": "What types of wood do you work with?",
								"answer": "We work with all types of wood including oak, maple, cherry, walnut, cedar, and composite materials. We'll help you choose the best option for your project and budget."
							},
							{
								"question": "How long does a typical project take?",
								"answer": "Project timelines vary based on scope. Small repairs may take a day, while custom cabinetry or deck construction can take 2-4 weeks. We'll provide a detailed timeline with your estimate."
							},
							{
								"question": "Do you offer warranties on your work?",
								"answer": "Yes, we provide a 1-year warranty on all workmanship. We also honor manufacturer warranties on materials and hardware."
							}
						]
					},
