{
	"name": "@starter/infinite-website",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": "./src/index.ts",
		"./catalog": "./src/catalog.ts",
		"./contracts": "./src/contracts.ts",
		"./editing": "./src/editing.ts",
		"./generation": "./src/generation.ts",
		"./preview": "./src/preview.ts",
		"./section-references": "./src/reference/section-references.ts",
		"./theme": "./src/theme.ts",
		"./template-previews": "./src/templates/template-previews.ts",
		"./templates/*": "./src/templates/*/index.ts",
		"./templates/*/assets": "./src/templates/*/assets.ts",
		"./templates/*/content": "./src/templates/*/content.json",
		"./styles.css": "./dist/styles.css"
	},
	"scripts": {
		"dev": "storybook dev -p 6006 --no-open",
		"build": "bun scripts/build-styles.ts",
		"dev:styles": "bun scripts/build-styles.ts --watch",
		"build-storybook": "storybook build",
		"generate:references": "bun scripts/generate-section-references.ts && oxfmt src/reference/section-references.generated.json",
		"react-doctor": "react-doctor . --score --blocking error",
		"shadscan": "shadscan . --fail-under 36 --no-interactive",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"test": "bun run --cwd ../.. test packages/infinite-website/tests",
		"verify": "bun run typecheck && bun run test"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@marcbachmann/cel-js": "^8.0.0",
		"@starter/infinite-brand": "workspace:*",
		"@starter/utils": "workspace:*",
		"@tiptap/static-renderer": "3.31.4",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.4.0",
		"culori": "4.0.2",
		"decimal.js": "^10.6.0",
		"embla-carousel": "^8.6.0",
		"embla-carousel-auto-scroll": "8.6.0",
		"embla-carousel-autoplay": "8.6.0",
		"embla-carousel-fade": "8.6.0",
		"embla-carousel-react": "^8.6.0",
		"quickjs-emscripten": "0.32.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"uuid": "^14.0.2",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@starter/tsconfig": "workspace:*",
		"@storybook/react-vite": "^10.6.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/culori": "^4.0.1",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"postcss": "^8.5.29",
		"postcss-prefix-selector": "^2.2.1",
		"storybook": "^10.6.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.3"
	},
	"reactDoctor": {
		"rules": {
			"eslint/max-lines": "off"
		},
		"ignore": {
			"overrides": [
				{
					"files": [
						"src/primitives/media-video.tsx"
					],
					"rules": [
						"react-doctor/iframe-missing-sandbox"
					]
				}
			]
		}
	}
}
