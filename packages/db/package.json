{
	"name": "@starter/db",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./mastra": {
			"types": "./src/mastra.ts",
			"import": "./src/mastra.ts",
			"default": "./src/mastra.ts"
		}
	},
	"scripts": {
		"drift": "DATABASE_URL=postgres://127.0.0.1:5432/drift DATABASE_URL_UNPOOLED=postgres://127.0.0.1:5432/drift drizzle-kit generate --explain --output json | grep -q '\"status\":\"no_changes\"' || (echo 'Schema and committed migrations are out of sync. Run make migrate and commit the migration.' && exit 1)",
		"generate": "drizzle-kit generate",
		"migrate": "drizzle-kit migrate && bun scripts/init-mastra.ts",
		"migrate:dev": "drizzle-kit generate && drizzle-kit migrate && bun scripts/init-mastra.ts",
		"studio": "drizzle-kit studio",
		"db:studio": "bunx dotenv-cli@11.0.0 -e ../../apps/webapp/.env -- drizzle-kit studio",
		"typecheck": "tsc --noEmit --skipLibCheck"
	},
	"dependencies": {
		"@mastra/core": "^1.74.0",
		"@mastra/pg": "^1.29.0",
		"@vercel/functions": "^3.9.11",
		"drizzle-orm": "^1.0.0-rc.5",
		"pg": "^8.23.1",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@starter/tsconfig": "workspace:*",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/node": "^26.6.4",
		"@types/pg": "^8.23.1",
		"@vitejs/plugin-react": "^6.1.2",
		"drizzle-kit": "^1.0.0-rc.5",
		"typescript": "^7.0.2"
	}
}
