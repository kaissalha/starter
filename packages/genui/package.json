{
	"name": "@starter/genui",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./library": {
			"types": "./src/library.ts",
			"import": "./src/library.ts",
			"default": "./src/library.ts"
		},
		"./text": {
			"types": "./src/text.ts",
			"import": "./src/text.ts",
			"default": "./src/text.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit --skipLibCheck"
	},
	"dependencies": {
		"@openuidev/lang-core": "^0.3.2",
		"@openuidev/react-lang": "^0.3.2",
		"mdast-util-from-markdown": "^2.1.0",
		"react": "^19.3.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@starter/tsconfig": "workspace:*",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"typescript": "^7.0.2"
	}
}
