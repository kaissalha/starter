{
	"name": "@starter/ui",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"files": [
		"globals.css"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./globals.css": "./src/globals.css",
		"./postcss.config": "./postcss.config.mjs",
		"./lib/*": "./src/lib/*.ts",
		"./components/charts/genui-chart-data": "./src/components/charts/genui-chart-data.ts",
		"./components/charts/genui-charts": "./src/components/charts/genui-charts.tsx",
		"./components/*": "./src/components/*.tsx",
		"./hooks/*": "./src/hooks/*.ts"
	},
	"scripts": {
		"react-doctor": "react-doctor . --score --blocking error",
		"shadscan": "shadscan . --fail-under 43 --no-interactive",
		"typecheck": "tsc --noEmit --skipLibCheck"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@daypicker/react": "10.0.2",
		"@hugeicons/core-free-icons": "^4.3.5",
		"@hugeicons/react": "^1.1.10",
		"@shadcn/react": "^0.3.1",
		"@starter/genui": "workspace:*",
		"@starter/utils": "workspace:*",
		"@tanstack/react-table": "^9.2.6",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.4.0",
		"date-fns": "^4.4.0",
		"input-otp": "^1.5.0",
		"motion": "14.0.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-resizable-panels": "^4.14.2",
		"recharts": "^3.10.1",
		"shadow-plugin": "2.1.1",
		"sonner": "^2.0.8",
		"tailwindcss-animate": "^1.0.7",
		"tw-shimmer": "^0.4.13",
		"use-media": "^1.5.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@starter/tsconfig": "workspace:*",
		"@tailwindcss/postcss": "^4.3.3",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"autoprefixer": "^10.6.1",
		"postcss": "^8.5.29",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2"
	},
	"reactDoctor": {
		"ignore": {
			"overrides": [
				{
					"files": [
						"postcss.config.mjs"
					],
					"rules": [
						"import/no-default-export"
					]
				},
				{
					"files": [
						"src/components/badge.tsx",
						"src/components/button.tsx",
						"src/components/navigation-menu.tsx",
						"src/components/root-portal.tsx",
						"src/components/toast-provider.tsx",
						"src/components/toaster.tsx",
						"src/components/toggle.tsx"
					],
					"rules": [
						"react-doctor/only-export-components"
					]
				},
				{
					"files": [
						"src/components/combobox.tsx",
						"src/components/credenza.tsx",
						"src/components/number-field.tsx",
						"src/components/root-portal.tsx",
						"src/components/tabs.tsx",
						"src/components/toggle-group.tsx"
					],
					"rules": [
						"react-doctor/jsx-no-constructed-context-values"
					]
				},
				{
					"files": [
						"src/components/input-group.tsx"
					],
					"rules": [
						"react-doctor/no-static-element-interactions"
					]
				},
				{
					"files": [
						"src/components/input-otp.tsx"
					],
					"rules": [
						"react-doctor/no-transition-all"
					]
				},
				{
					"files": [
						"src/hooks/use-hydrated.ts"
					],
					"rules": [
						"react-doctor/rendering-hydration-no-flicker",
						"react-doctor/no-initialize-state"
					]
				}
			]
		}
	}
}
