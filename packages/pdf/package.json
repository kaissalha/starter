{
	"name": "@starter/pdf",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"react-doctor": "react-doctor . --score --blocking error",
		"typecheck": "tsc --noEmit --skipLibCheck"
	},
	"dependencies": {
		"@react-pdf/renderer": "^4.9.0",
		"@react-pdf/types": "^2.14.0",
		"@starter/utils": "workspace:*",
		"mdast-util-from-markdown": "^2.1.0",
		"qrcode": "^1.5.4",
		"react": "^19.3.0"
	},
	"devDependencies": {
		"@starter/tsconfig": "workspace:*",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.4",
		"@types/qrcode": "^1.5.6",
		"@types/react": "19.3.0",
		"pdfjs-dist": "^6.4.299",
		"typescript": "^7.0.2"
	},
	"reactDoctor": {
		"ignore": {
			"overrides": [
				{
					"files": [
						"src/components/ui/**",
						"src/components/footer.tsx",
						"src/components/logo.tsx",
						"src/components/styles.ts"
					],
					"rules": [
						"react-doctor/prefer-dynamic-import"
					]
				},
				{
					"files": [
						"src/components/ui/**"
					],
					"rules": [
						"deslop/unused-file"
					]
				},
				{
					"files": [
						"src/components/ui/data-table.tsx",
						"src/components/ui/form.tsx",
						"src/components/ui/graph.tsx",
						"src/components/ui/list.tsx"
					],
					"rules": [
						"react-doctor/no-array-index-as-key"
					]
				}
			]
		}
	}
}
