# Required in production (the app warns at boot when these are missing)
BETTER_AUTH_SECRET=
CRON_SECRET=
# Local Docker Postgres: postgres://starter:<password from docker-compose.yml>@localhost:5432/starter
DATABASE_URL=
REDIS_URL=
WEBSITES_PLATFORM_DOMAIN=

# Required at import time (the process throws without them)
AI_GATEWAY_API_KEY=
RESEND_KEY=

# Optional integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FIRECRAWL_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
UPSTASH_URL=
UPSTASH_TOKEN=
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_READ_WRITE_TOKEN=
VERCEL_BLOB_CALLBACK_URL=
TINYBIRD_URL=
TINYBIRD_READ_TOKEN=
TINYBIRD_APPEND_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
VERCEL_DOMAINS_TOKEN=
VERCEL_DOMAINS_TEAM_ID=
VERCEL_WEBSITES_PROJECT_ID=
DOMAIN_PURCHASES_ENABLED=
WEBAPP_URL=http://localhost:3000
WEBSITES_URL=

# Local development only
ALLOWED_DEV_ORIGINS=
REACT_SCAN=
NEXT_PUBLIC_ENABLE_QUERY_DEVTOOLS=
NEXT_PUBLIC_ENABLE_OPENUI_DEVTOOLS=
