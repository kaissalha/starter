# Required in production (the app warns at boot when these are missing)
BETTER_AUTH_SECRET=
CRON_SECRET=
# Signs upload tokens for /api/files; generate with: openssl rand -base64 32
FILES_API_SECRET=your-files-api-secret

# Local Docker Postgres: postgres://starter:<password from docker-compose.yml>@localhost:5432/starter
DATABASE_URL=
REDIS_URL=

# Required at import time (the process throws without them)
AI_GATEWAY_API_KEY=
RESEND_KEY=

# Optional integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FIRECRAWL_API_KEY=
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_READ_WRITE_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
WEBAPP_URL=http://localhost:3000

# Local development only
ALLOWED_DEV_ORIGINS=
REACT_SCAN=
NEXT_PUBLIC_ENABLE_QUERY_DEVTOOLS=
NEXT_PUBLIC_ENABLE_OPENUI_DEVTOOLS=
